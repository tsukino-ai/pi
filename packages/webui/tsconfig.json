{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"module": "ES2022",
		"jsx": "react-jsx",
		"moduleResolution": "bundler",
		"target": "ES2022",
		"lib": ["ES2022", "DOM"],
		"types": ["node", "vitest/globals"],
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"]
		}
	},
	"include": ["src/**/*", "test/**/*"],
	"exclude": ["dist", "node_modules"]
}
