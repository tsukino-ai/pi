{
	"name": "@earendil-works/pi-webui",
	"version": "0.78.0",
	"private": true,
	"type": "module",
	"description": "Standalone browser-based Web UI for pi coding-agent",
	"scripts": {
		"clean": "shx rm -rf dist",
		"dev": "concurrently \"npm run dev:bridge\" \"npm run dev:vite\"",
		"dev:vite": "vite",
		"dev:bridge": "tsx bridge-server/index.ts",
		"build": "vite build",
		"check": "tsc --noEmit",
		"test": "vitest --run"
	},
	"dependencies": {
		"@ant-design/x": "1.3.0",
		"ansi-to-html": "0.7.2",
		"antd": "5.29.3",
		"highlight.js": "11.11.1",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"ws": "8.21.0"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "^0.78.0",
		"@earendil-works/pi-ai": "^0.78.0",
		"@earendil-works/pi-coding-agent": "^0.78.0",
		"@types/node": "24.12.4",
		"@types/react": "19.2.15",
		"@types/react-dom": "19.2.3",
		"@types/ws": "8.18.1",
		"@vitejs/plugin-react": "4.4.0",
		"@testing-library/react": "16.3.0",
		"concurrently": "10.0.0",
		"jsdom": "26.1.0",
		"shx": "0.4.0",
		"tsx": "4.22.3",
		"typescript": "5.9.3",
		"vite": "6.3.0",
		"vitest": "3.2.4"
	}
}
